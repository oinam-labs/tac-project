{
  "tech_stack": [
    "TypeScript",
    "Next.js 16",
    "React 19",
    "Supabase",
    "TailwindCSS",
    "Zod",
    "TanStack Query",
    "Radix UI",
    "Lucide Icons",
    "Jest"
  ],
  "features": [
    {
      "name": "Authentication",
      "description": "User authentication with Supabase Auth, session management, and protected routes",
      "files": [
        "lib/supabase/middleware.ts",
        "lib/supabase/server.ts",
        "lib/supabase/client.ts",
        "app/login/page.tsx"
      ]
    },
    {
      "name": "Shipment Management",
      "description": "CRUD operations for shipments including create, update, cancel, and search functionality",
      "files": [
        "app/actions/shipments.ts",
        "app/actions/shipment-crud.ts",
        "app/(dashboard)/dashboard/shipments/page.tsx",
        "app/(dashboard)/dashboard/shipments/[id]/page.tsx"
      ]
    },
    {
      "name": "Manifest Management",
      "description": "Create, lock, dispatch manifests and manage shipment assignments",
      "files": [
        "app/actions/manifests.ts",
        "app/actions/manifest-crud.ts",
        "app/(dashboard)/dashboard/manifests/page.tsx",
        "app/(dashboard)/dashboard/manifests/[id]/page.tsx"
      ]
    },
    {
      "name": "Customer Management",
      "description": "Customer CRUD operations with autocomplete search",
      "files": [
        "app/actions/customers.ts",
        "app/actions/customer-crud.ts",
        "app/actions/customer-autocomplete.ts",
        "app/(dashboard)/dashboard/customers/page.tsx"
      ]
    },
    {
      "name": "Invoice Management",
      "description": "Invoice creation, editing, PDF generation, and enterprise features",
      "files": [
        "app/actions/invoices.ts",
        "app/actions/invoice-crud.ts",
        "app/actions/invoice-enhanced.ts",
        "app/actions/invoice-enterprise.ts",
        "app/(dashboard)/dashboard/invoices/page.tsx"
      ]
    },
    {
      "name": "Payment Processing",
      "description": "Payment management with Razorpay integration",
      "files": [
        "app/actions/payments.ts",
        "app/actions/payment-crud.ts",
        "lib/payments/razorpay.ts",
        "app/api/webhooks/razorpay/route.ts"
      ]
    },
    {
      "name": "Tracking System",
      "description": "Real-time shipment tracking with public tracking page",
      "files": [
        "app/actions/tracking.ts",
        "app/track/page.tsx",
        "app/track/[awb]/page.tsx",
        "app/(dashboard)/dashboard/tracking/page.tsx"
      ]
    },
    {
      "name": "Inventory Management",
      "description": "Warehouse inventory tracking and management",
      "files": [
        "app/actions/inventory.ts",
        "app/(dashboard)/dashboard/inventory/page.tsx"
      ]
    },
    {
      "name": "Scanning Module",
      "description": "Barcode scanning for shipment processing",
      "files": [
        "app/actions/scanning.ts",
        "app/(dashboard)/dashboard/scanning/page.tsx"
      ]
    },
    {
      "name": "Notification Services",
      "description": "Email, SMS, and WhatsApp notification integrations",
      "files": [
        "lib/services/notification-service.ts",
        "lib/services/email-service.ts",
        "lib/services/sms-service.ts",
        "lib/notifications/email.ts",
        "lib/notifications/sms.ts",
        "lib/notifications/whatsapp.ts",
        "app/actions/whatsapp.ts"
      ]
    },
    {
      "name": "PDF Generation",
      "description": "Generate PDF documents for invoices and shipping labels",
      "files": [
        "app/actions/pdf-generation.ts",
        "app/api/invoices/[id]/pdf/route.ts",
        "app/api/invoices/[id]/label/route.ts"
      ]
    },
    {
      "name": "Dashboard Analytics",
      "description": "Dashboard with overview cards, charts, and metrics",
      "files": [
        "app/(dashboard)/dashboard/page.tsx",
        "app/(dashboard)/dashboard/analytics/page.tsx",
        "app/(dashboard)/dashboard/_components/overview-cards.tsx",
        "app/(dashboard)/dashboard/_components/mission-control.tsx"
      ]
    },
    {
      "name": "Security Utilities",
      "description": "Security headers, CORS, and environment validation",
      "files": [
        "lib/security/headers.ts",
        "lib/env-validation.ts"
      ]
    },
    {
      "name": "API Routes",
      "description": "RESTful API endpoints for external integrations",
      "files": [
        "app/api/shipments/route.ts",
        "app/api/customers/route.ts",
        "app/api/invoices/route.ts",
        "app/api/payments/route.ts",
        "app/api/manifests/route.ts"
      ]
    }
  ]
}
