{
    "extends": [
        "stylelint-config-standard"
    ],
    "rules": {
        "color-no-hex": true,
        "color-named": "never",
        "function-disallowed-list": [
            "rgb",
            "rgba",
            "hsl",
            "hsla"
        ],
        "declaration-property-value-disallowed-list": {
            "/^background/": [
                "/^#/",
                "/^rgb/",
                "/^hsl/"
            ],
            "/^color/": [
                "/^#/",
                "/^rgb/",
                "/^hsl/"
            ],
            "/^border/": [
                "/^#/",
                "/^rgb/",
                "/^hsl/"
            ]
        },
        "at-rule-no-unknown": [
            true,
            {
                "ignoreAtRules": [
                    "tailwind",
                    "apply",
                    "layer",
                    "config",
                    "plugin",
                    "theme",
                    "custom-variant",
                    "import"
                ]
            }
        ],
        "function-no-unknown": [
            true,
            {
                "ignoreFunctions": [
                    "theme",
                    "screen",
                    "color-mix",
                    "oklch"
                ]
            }
        ],
        "import-notation": null
    },
    "ignoreFiles": [
        "node_modules/**",
        ".next/**",
        "out/**",
        "dist/**"
    ]
}